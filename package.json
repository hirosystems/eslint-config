{
  "name": "@stacks/eslint-config",
  "version": "3.0.0-develop.3",
  "description": "A re-usable ESLint config for Stacks projects",
  "repository": "https://github.com/hirosystems/eslint-config",
  "author": "@stacks",
  "prettier": "@stacks/prettier-config",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepublishOnly": "npm run build"
  },
  "contributors": [
    {
      "name": "Hank Stoever",
      "url": "https://www.hankstoever.com"
    },
    {
      "name": "@kyranjamie",
      "url": "https://kyranjamie.com"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@eslint/js": ">= 9",
    "@stacks/prettier-config": "^0.0.10",
    "eslint-config-prettier": ">=10",
    "eslint-plugin-prettier": ">= 5",
    "typescript-eslint": ">= 8"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "semantic-release": "^24.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "develop",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      "@semantic-release/github",
      "@semantic-release/changelog",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
